        "layer": "structural",
        "expected": [
          {
            "code": "UNSUPPORTED_VALUE",
            "path": ["frame"]
          }
        ]
      },
      {
        "id": "epoch-scale",
        "description": "epoch.scale \"TAI\"",
        "mutations": [
          {
            "op": "set",
            "path": ["epoch", "scale"],
