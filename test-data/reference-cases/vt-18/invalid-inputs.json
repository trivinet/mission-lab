{
  "id": "vt-18/invalid-inputs",
  "version": 1,
  "family": "VT-18 Invalid input handling (ML-FR-002 AC2, ML-FR-005 AC2, ML-FR-011 AC3)",
  "description": "One mutation of a valid base scenario per invalid-input class, with the expected issues (code and path) decided from the contract text; accepted controls at the boundaries.",
  "status": "Committed before any engine run on it (tolerances.md §4.1 item 1; ML-TASK-018 part C phase 1). Not yet reviewed or approved; immutable once approved, corrections create a new version (plan §6).",
  "inputs": {
    "baseScenario": {
      "schemaVersion": "1.0",
      "id": "vt18-base",
      "name": "VT-18 base scenario",
      "centralBody": "EARTH",
      "frame": "GCRF",
      "epoch": {
        "scale": "UTC",
        "iso": "2026-01-01T00:00:00.000Z"
      },
      "initialOrbit": {
        "kind": "KEPLERIAN",
        "elements": {
          "semiMajorAxis_m": 7000000,
          "eccentricity": 0.001,
          "inclination_rad": 0.9,
          "raan_rad": 1.2,
          "argPeriapsis_rad": 0.5,
          "trueAnomaly_rad": 0.3
        }
      },
      "maneuvers": [
        {
          "id": "m1",
          "t_s": 1000,
          "frame": "RSW",
          "deltaV_mps": [0, 10, 0]
        }
      ],
      "duration_s": 6000,
      "outputStep_s": 60
    },
    "encoding": "A value {\"$number\": \"NaN\" | \"Infinity\" | \"-Infinity\" | \"-0\"} stands for that binary64 value (JSON cannot carry it). Mutations are applied in order to a deep copy of baseScenario: \"set\" assigns at the path (creating array slots), \"delete\" removes the key.",
    "cases": [
      {
        "id": "schema-version-other",
        "description": "schemaVersion \"1.1\"",
        "mutations": [
          {
            "op": "set",
            "path": ["schemaVersion"],
            "value": "1.1"
          }
        ],
        "layer": "structural",
        "expected": [
          {
            "code": "SCHEMA_VERSION_UNSUPPORTED",
            "path": ["schemaVersion"]
          }
        ]
      },
      {
        "id": "schema-version-missing",
        "description": "schemaVersion missing (other errors present are not reported)",
        "mutations": [
          {
            "op": "delete",
            "path": ["schemaVersion"]
          },
          {
            "op": "set",
            "path": ["duration_s"],
            "value": -1
          }
        ],
        "layer": "structural",
        "expected": [
          {
            "code": "SCHEMA_VERSION_UNSUPPORTED",
            "path": ["schemaVersion"]
          }
        ]
      },
      {
        "id": "not-an-object",
        "description": "Input is a string",
        "mutations": [],
        "replaceInput": "scenario",
        "layer": "structural",
        "expected": [
          {
            "code": "TYPE_MISMATCH",
            "path": []
          }
        ]
      },
      {
        "id": "id-empty",
        "description": "Scenario id \"\"",
        "mutations": [
          {
            "op": "set",
            "path": ["id"],
            "value": ""
          }
        ],
        "layer": "structural",
        "expected": [
          {
            "code": "ID_EMPTY",
            "path": ["id"]
          }
        ]
      },
      {
        "id": "name-not-string",
        "description": "name is a number",
        "mutations": [
          {
            "op": "set",
            "path": ["name"],
            "value": 5
          }
        ],
        "layer": "structural",
        "expected": [
          {
            "code": "TYPE_MISMATCH",
            "path": ["name"]
          }
        ]
      },
      {
        "id": "central-body",
        "description": "centralBody \"MOON\"",
        "mutations": [
          {
            "op": "set",
            "path": ["centralBody"],
            "value": "MOON"
          }
        ],
        "layer": "structural",
        "expected": [
          {
            "code": "UNSUPPORTED_VALUE",
            "path": ["centralBody"]
          }
        ]
      },
      {
        "id": "frame",
        "description": "frame \"EME2000\"",
        "mutations": [
          {
            "op": "set",
            "path": ["frame"],
            "value": "EME2000"
          }
